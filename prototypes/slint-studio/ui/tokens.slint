// Design tokens. Colours mirror src/view/theme.rs. In the real app this file
// is generated from one source that also feeds the Iced overlays.
export global Tokens {
    out property <color> surface: #17181C;
    out property <color> header: #1C1D22;
    out property <color> nav: #1A1B20;
    out property <color> raised: #202227;
    out property <color> control: #23252B;
    out property <color> hover: #2C2F36;
    out property <color> well: #111216;
    out property <color> line: #FFFFFF14;
    out property <color> line-strong: #FFFFFF1F;
    out property <color> text: #F3F4F6;
    out property <color> text-soft: #E5E7EB;
    out property <color> subtle: #C9CDD4;
    out property <color> muted: #A1A6B0;
    out property <color> cyan: #22D3EE;
    out property <color> cyan-text: #67E8F9;
    out property <color> cyan-bg: #22D3EE29;

    out property <length> font-body: 13px;
    out property <length> font-label: 12px;
    out property <length> font-nav: 14px;
    out property <length> font-h1: 22px;
    out property <length> font-h2: 15px;

    out property <length> radius-control: 8px;
    out property <length> radius-card: 10px;
    out property <length> h-control: 32px;
    out property <length> h-nav: 40px;
    out property <length> gap: 10px;
}
