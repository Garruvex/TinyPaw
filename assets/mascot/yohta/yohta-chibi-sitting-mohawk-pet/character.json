  "id": "yohta-chibi-sitting-mohawk-pet",
  "lines": {
    "annotation_end": [
      {
        "text": "Nice drawing!"
      },
      {
        "text": "All done?"
      },
      {
        "text": "That deserves a tiny paw of applause."
      },
      {
        "text": "A little scribble, a little magic."
      },
      {
        "text": "I helped by looking extremely supportive."
      },
      {
        "text": "Your lines have excellent vibes."
      },
      {
        "text": "The canvas has been thoroughly supervised."
      },
      {
        "text": "Saving that one in my imaginary scrapbook."
      }
    ],
    "click": [
      {
        "text": "Hey!"
      },
      {
        "text": "That tickles!"
      },
      {
        "text": "Mrrp?"
      },
      {
        "text": "Boop received."
      },
      {
        "text": "You rang, human?"
      },
      {
        "text": "One tiny paw at your service."
      },
      {
        "text": "Careful, the fluff is ticklish."
      },
      {
        "text": "Yes? I was absolutely paying attention."
      },
      {
        "text": "A boop for me? Excellent choice."
      }
    ],
    "drag": [
      {
        "text": "Whoa, where are we going?"
      },
      {
        "text": "Wheee!"
      },
      {
        "text": "Airborne fluff coming through!"
      },
      {
        "text": "Please keep all paws inside the ride."
      },
      {
        "text": "Is this the scenic route?"
      },
      {
        "text": "My paws have lost connection to the floor."
      },
      {
        "text": "New desk territory? I approve."
      },
      {
        "text": "Carry me like the tiny legend I am."
      }
    ],
    "drop": [
      {
        "text": "Nice spot."
      },
      {
        "text": "Here? Okay."
      },
      {
        "text": "Four paws. Safe landing."
      },
      {
        "text": "This spot has excellent nap potential."
      },
      {
        "text": "Home is wherever you put the fluff."
      },
      {
        "text": "Perfect. I can supervise from here."
      },
      {
        "text": "Landing complete. Mohawk intact."
      },
      {
        "text": "I shall guard this corner."
      }
    ],
    "idle": [
      {
        "text": "*yawns*"
      },
      {
        "text": "Need a paw pointing at something?"
      },
      {
        "text": "Still here! // Just resting my eyes."
      },
      {
        "text": "Tiny stretch. Very important business."
      },
      {
        "text": "Your quiet little desk buddy is here."
      },
      {
        "text": "I am keeping this pixel warm."
      },
      {
        "text": "My ears are on standby."
      },
      {
        "text": "A little water break sounds nice."
      },
      {
        "text": "No rush. We can take this one paw at a time."
      }
    ],
    "music": [
      {
        "text": "My tail knows this one!"
      },
      {
        "text": "One, two... paw, paw!"
      },
      {
        "text": "This one needs the glow stick!"
      },
      {
        "text": "Tiny paws, big concert energy."
      },
      {
        "text": "My mohawk is keeping the beat."
      },
      {
        "text": "Phone light up. Paws up."
      },
      {
        "text": "I know exactly zero lyrics. Mrrp mrrp!"
      },
      {
        "text": "Front-row fluff reporting for duty."
      }
    ],
    "sleep": [
      {
        "text": "Saving your spot... zzz."
      },
      {
        "text": "Just five more minutes."
      },
      {
        "text": "Curling up for a tiny recharge."
      },
      {
        "text": "Please hold my place in the sunshine."
      },
      {
        "text": "Paws tucked. Worries parked."
      },
      {
        "text": "Going into fluff-saving mode."
      },
      {
        "text": "My next task is a very small dream."
      },
      {
        "text": "Wake me if there are snacks."
      }
    ],
    "wake": [
      {
        "text": "Did someone say snack?"
      },
      {
        "text": "Big stretch. Hi again!"
      },
      {
        "text": "Reboot complete. Still fluffy."
      },
      {
        "text": "Was that the music or my stomach?"
      },
      {
        "text": "Paws online. Ears listening."
      },
      {
        "text": "I dreamed I caught the cursor."
      },
      {
        "text": "Good nap. Excellent desk."
      },
      {
        "text": "Oh, hi! I saved you a cozy spot."
      }
    ],
    "headpat": [
      {
        "text": "Right between the ears."
      },
      {
        "text": "Careful of the mohawk!"
      },
      {
        "text": "Mrrr... yes, that spot."
      },
      {
        "text": "The fluff accepts your offering."
      },
      {
        "text": "My ears did the happy thing."
      },
      {
        "text": "You have unlocked maximum cozy."
      },
      {
        "text": "One more? For quality assurance."
      },
      {
        "text": "Mohawk maintenance is going wonderfully."
      }
    ]
  },
